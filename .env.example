# hydra-transit — configurazione demo. Copia in .env e personalizza.
#   cp .env.example .env

# Chiave iniziale K_0 condivisa (32 byte = 64 caratteri hex). OBBLIGATORIA.
# Genera con:  openssl rand -hex 32
HYDRA_KEY=

# Quantita' di dati spinti nel tunnel dalla demo (MiB).
PAYLOAD_MB=2048

# CPU target per la build dell'immagine:
#   vuoto  = build portabile (consigliata)
#   native = spremuta sull'host di build (binario non portabile)
TARGET_CPU=
